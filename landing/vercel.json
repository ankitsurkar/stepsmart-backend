{
  "rewrites": [
    {
      "source": "/learn/:path*",
      "destination": "https://stepsmart-backend-lyart.vercel.app/:path*"
    },
    {
      "source": "/learn",
      "destination": "https://stepsmart-backend-lyart.vercel.app"
    },
    {
      "source": "/live",
      "destination": "/live/phone.html"
    },
    {
      "source": "/live/",
      "destination": "/live/phone.html"
    },
    {
      "source": "/live/host",
      "destination": "/live/host.html"
    },
    {
      "source": "/live/phone",
      "destination": "/live/phone.html"
    },
    {
      "source": "/live/replay",
      "destination": "/live/replay.html"
    },
    {
      "source": "/live/preview",
      "destination": "/live/preview.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
