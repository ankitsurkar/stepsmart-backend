# Apify API Credentials
# Optional legacy scrape provider. If BRAVE_SEARCH_API_KEY is configured, dashboard discovery uses Brave instead.
APIFY_API_KEY=your_apify_api_token_here
# Apify Actor ID for LinkedIn Post Search (e.g. curious_coder/linkedin-post-search-scraper or standard actor)
APIFY_ACTOR_ID=curious_coder/linkedin-post-search-scraper

# Brave Search API: discovers public LinkedIn post URLs; candidates require manual verification.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Apify cost guard: at most 8 run reservations in any rolling 30 days, at least 72 hours apart.
APIFY_MAX_RUNS_PER_MONTH=8
APIFY_MIN_INTERVAL_HOURS=72
APIFY_SCHEDULE_INTERVAL_HOURS=84

# Google Sheets Configuration
# The ID of your Google Sheet (from URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Path to service_account.json credentials file if using Google Sheets API
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
